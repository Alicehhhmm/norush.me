{
  "name": "@nw/ui",
  "version": "0.0.2",
  "type": "module",
  "homepage": "https://github.com/Alicehhhmm/norush.me/tree/main/packages/nui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alicehhhmm/norush.me.git",
    "directory": "packages/nui"
  },
  "license": "MIT",
  "author": "Norush",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./src/index.js"
    },
    "./*": {
      "default": [
        "./src/*",
        "./src/*.tsx",
        "./src/*/index.tsx",
        "./src/*.ts",
        "./src/*/index.ts"
      ],
      "rolldown": [
        "./dist/*",
        "./dist/*.js",
        "./dist/*/index.js"
      ]
    },
    "./tailwind": {
      "import": "./dist/esm/index.css",
      "require": "./dist/cjs/index.css",
      "default": "./src/styles/tailwind.css"
    }
  },
  "imports": {
    "#ui/*": {
      "default": [
        "./src/*",
        "./src/*.tsx",
        "./src/*/index.tsx",
        "./src/*.ts",
        "./src/*/index.ts"
      ],
      "rolldown": [
        "./dist/*",
        "./dist/*.js",
        "./dist/*/index.js"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "rslib build --watch",
    "cls": "pnpm exec rimraf node_modules",
    "build": "pnpm exec rimraf dist && rslib build",
    "storybook": "pnpm exec storybook dev -p 6006",
    "build:storybook": "pnpm exec storybook build",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\" && stylelint \"**/*.css\" --allow-empty-input",
    "lint:fix": "eslint \"**/*.{js,mjs,ts,tsx}\" --fix && stylelint \"**/*.css\" --fix",
    "lint:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm exec rimraf dist .turbo coverage",
    "clean:all": "pnpm exec rimraf dist node_modules .turbo coverage",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "postcss-loader": "^8.2.1",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-three/drei": "10.0.0-rc.1",
    "@react-three/fiber": "9.5.0",
    "@rsbuild/core": "~1.7.0",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rslib/core": "^0.19.1",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "@storybook/addon-themes": "^10.2.19",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.183.1",
    "@vitest/coverage-v8": "catalog:",
    "classnames": "^2.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.2.19",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "catalog:",
    "postcss-calc": "^10.1.1",
    "postcss-cli": "11.0.1",
    "rimraf": "^6.0.1",
    "storybook": "^10.2.19",
    "storybook-addon-rslib": "^3.3.2",
    "storybook-react-rsbuild": "^3.3.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "7.0.1",
    "stylelint-selector-bem-pattern": "4.0.1",
    "tailwindcss": "catalog:",
    "three": "^0.183.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.48.0",
    "vitest": "catalog:"
  }
}
