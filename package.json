{
  "name": "norush.me",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Norush.me Website",
  "homepage": "https://norushme.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alicehhhmm/norush.me.git"
  },
  "author": {
    "name": "Norush",
    "email": "a007aplum@gmail.com"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "storybook": "turbo storybook",
    "storybook:build": "turbo build:storybook",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:staged": "lint-staged",
    "lint:types": "turbo lint:types",
    "prepare": "husky",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "changeset:tag": "changeset tag",
    "release": "pnpm build && changeset publish",
    "release:canary": "changeset publish --tag canary",
    "version": "changeset version",
    "changelog": "node scripts/generate-changelog.js",
    "changelog:check": "changeset status",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.183.1",
    "three": "^0.183.2",
    "turbo": "2.7.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "~9.39.2",
    "@reporters/github": "^1.11.0",
    "@testing-library/react": "~16.3.1",
    "cross-env": "^10.1.0",
    "eslint": "~9.39.2",
    "eslint-import-resolver-typescript": "~4.4.4",
    "eslint-plugin-import-x": "~4.16.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "catalog:",
    "typescript-eslint": "8.51.0"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "**/*.{js,jsx,mjs,ts,tsx,md,mdx,json.yml}": [
      "prettier --check --write"
    ]
  },
  "packageManager": "pnpm@10.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=v24.11.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.24.0",
      "onFail": "error"
    }
  }
}
